# Server-only auth endpoints (DO NOT prefix with NEXT_PUBLIC_)
IAM_BASE_URL=
BFF_GRAPHQL_URL=

# Demo / test auth without IAM (OTP skipped; session opens on login)
# Keep false when a real IAM backend is connected.
DEV_AUTH_BYPASS=false
# Client hint on sign-in form (must match DEV_AUTH_BYPASS for the banner)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
DEV_DEMO_EMAIL=
DEV_DEMO_PASSWORD=
DEV_DEMO_OTP=
DEV_DEMO_LOGIN_SESSION_ID=
